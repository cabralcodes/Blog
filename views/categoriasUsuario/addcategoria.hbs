<h3>Nova Categoria</h3>
<div class="card mt-4">
    <div class="card-body">
        <form action="/usuario/categorias/nova" method="POST">
            <label for="nome">Nome:</label>
            <input type="text" name="nome" placeholder="Ex: Tecnologia" class="form-control" required>
            
            <label for="slug" class="mt-2">Slug:</label>
            <input type="text" name="slug" placeholder="Ex: tecnologia-avancada" class="form-control" required>
            
            <button type="submit" class="btn btn-success mt-4">Criar Categoria</button>
        </form>
    </div>
</div>
