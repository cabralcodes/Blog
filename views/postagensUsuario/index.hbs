<h1>Lista de Postagens</h1>
<hr>

{{#if user}}
{{!-- Ajustado para a rota de criação do usuário comum --}}
<a href="/usuario/postagens/add">
    <button class="btn btn-success">Nova Postagem</button>
</a>
{{/if}}

{{#each postagens}}
<div class="card mt-4">
    <div class="card-body">
        <h4>{{titulo}}</h4>
        <p>Descrição: {{descricao}}</p>
        {{!-- Exibe o conteúdo --}}
        <div class="mt-3">
    <h5 class="text-muted">Conteúdo da Postagem:</h5>
    <div class="p-4 bg-light border-start border-4 border-success rounded shadow-sm" style="font-size: 1.1rem; line-height: 1.6;">
        {{{conteudo}}}
    </div>
</div>

        <small>Data: {{formatDate data}}</small><br>
        {{!-- O populate("usuario") no back-end é essencial para o nome aparecer aqui --}}
        <small>Publicado por: <strong>{{usuario.nome}}</strong></small><br>
        <small>Categoria: {{categoria.nome}}</small> <br>


        {{!-- BOTÕES SÓ PRO DONO OU ADMIN --}}
        {{#podeEditar usuario ../user}}
            <a href="/usuario/postagens/editar/{{_id}}" class="btn btn-warning mt-3">
                Editar Postagem
            </a><br>

            <a href="/usuario/postagens/deletar/{{_id}}" class="btn btn-danger mt-3">
                Deletar Postagem
            </a>
        {{/podeEditar}}

    </div>
</div>
{{else}}
<p>Nenhuma Postagem registrada!</p>
{{/each}}
