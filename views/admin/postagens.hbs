<h1>Listas de postagens</h1>
<hr>
<a href="/admin/postagens/add"><button class="btn btn-success">Nova Postagem</button></a>

{{#each postagens}}
<div class="card custom-post-card">
    <div class="card-body p-4">
        
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="badge-category">{{categoria.nome}}</span>
            <span class="text-muted small"><i class="far fa-calendar-alt"></i> {{formatDate data}}</span>
        </div>

        <h2 class="post-title">{{titulo}}</h2>
        
        <div class="post-meta">
            <span><i class="fas fa-user"></i> Por: <strong>{{usuario.nome}}</strong></span>
        </div>

        <p class="text-secondary"><em>{{descricao}}</em></p>

        <div class="post-body-content">
            {{{conteudo}}}
        </div>

        <div class="mt-4 d-flex gap-2 flex-wrap">
            <a href="/postagem/{{slug}}/{{_id}}" class="btn btn-success btn-read-more">
                Ler completo
            </a>

            {{#podeEditar usuario ../user}}
                <a href="/usuario/postagens/editar/{{_id}}" class="btn btn-outline-warning btn-read-more">Editar</a>
                <form action="/usuario/postagens/deletar" method="POST" style="display: inline;">
                    <input type="hidden" name="id" value="{{_id}}">
                    <button class="btn btn-outline-danger btn-read-more">Deletar</button>
                </form>
            {{/podeEditar}}
        </div>

    </div>
</div>
{{else}}
    <div class="text-center p-5">
        <h3 class="text-muted">Ainda não há nada publicado por aqui. ✍️</h3>
    </div>
{{/each}}
